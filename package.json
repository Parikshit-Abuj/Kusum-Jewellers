  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.1",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "5.0.4"
